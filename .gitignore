# --- Secrets (never commit) ---
.env
.env.*
*.key
secrets.json

# --- Model weights and large artifacts (never commit) ---
*.pt
*.pth
*.safetensors
*.bin
*.ckpt
*.gguf
models/
cache/
*.zip
*.tar
*.tar.gz

# --- Generated per-run outputs ---
# Ignore per-item outputs; keep the human-facing summaries
# (AGENTS.md §6: mock per-item outputs are not committed; the summary is).
results/*
!results/summary.md
!results/*/
results/*/*
!results/*/summary.md

